        {
          "phase": "finetune",
          "name": "opt4",
          "title": "opt4 fine-tune at 2048 bytes, seed 29 (effective batch 32)",
          "script": "experiment.py",
          "archived_args": "reports/runs/best/r9_opt4_wide_seed29/args.json",
          "overrides": {
            "batch_size": 4,
            "grad_accum": 8,
            "workers": 6,
