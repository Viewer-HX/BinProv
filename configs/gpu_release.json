          "archived_args": "reports/runs/best/mlm512/pretrain_args.json",
          "overrides": {
            "batch_size": 64,
            "grad_accum": 4,
            "workers": 6,
            "save_every_epoch": true,
            "resume": true
          },
          "out": "mlm512",
          "init_from_step": null,
          "micro_batch": 64,
          "grad_accum": 4,
          "workers": 6,
          "effective_batch": 256,
          "archived_effective": 256
        },
        {
          "phase": "pretrain2048",
          "name": "mlm2048",
          "title": "2048-byte continued MLM from mlm512 (effective batch 64)",
          "script": "pretrain_mlm.py",
          "args": {
            "splits": "default",
            "split_name": "train",
            "seq_bytes": 2048,
