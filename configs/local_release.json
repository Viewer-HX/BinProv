{
  "_comment": "Bounded local-training profiles for an Apple-Silicon (MPS) machine. Machine-readable source of truth for scripts/train_local_release.py (dry-run default), scripts/export_hf.py, and docs/LOCAL_TRAINING.md. Every training step is an archived recipe re-expressed for a small micro-batch on MPS with gradient accumulation, so the archived *effective* batch size is preserved exactly while the micro-batch and the data-loader workers fit one Mac. All output lands under results/local_release/<profile>/; historical paths under checkpoints/, reports/ and results/explore are never written.",
  "meta": {
    "results_dir": "results/local_release",
    "logs_dir": "logs",
    "corpus_dir": "data/corpus/binkit_x86_64",
    "splits": "default",
    "split_evidence": "reports/tables/split_programs.txt",
    "backend": "mps",
    "license": "LICENSE",
    "disk_reserve_gb": 80,
    "archived_targets": {
      "opt4_narrow_seed13": {
        "description": "archived 512-byte opt4 target this profile reproduces",
        "archived_result": "reports/runs/best/r9_opt4_base_seed13/result.json",
        "expected_seq_accuracy": 0.8111,
        "archived_binary_accuracy": 0.9282
      },
      "opt4_wide_seed29": {
        "description": "archived 2048-byte opt4 target this profile reproduces",
        "archived_result": "reports/runs/best/r9_opt4_wide_seed29/result.json",
        "expected_seq_accuracy": 0.8385,
        "archived_binary_accuracy": 0.9388
      }
    }
  },
  "profiles": {
    "opt4_narrow_seed13": {
      "description": "Recommended. 512-byte encoder, opt4 (O0/O1/O2/O3), seed 13, matching reports/runs/best/r9_opt4_base_seed13. Effective batch 128 == archived batch 128.",
      "recommended": true,
      "task": "opt4",
      "model_name": "binprov-opt4-narrow-seed13",
      "backend": "mps",
      "steps": [
        {
          "phase": "pretrain512",
          "name": "mlm512",
          "title": "512-byte MLM pre-training (archived effective batch 256)",
          "script": "pretrain_mlm.py",
          "archived_args": "reports/runs/best/mlm512/pretrain_args.json",
          "overrides": {
            "batch_size": 16,
            "grad_accum": 16,
            "workers": 0,
            "save_every_epoch": true,
            "resume": true
          },
          "out": "mlm512",
          "init_from_step": null,
          "micro_batch": 16,
          "grad_accum": 16,
          "workers": 0,
          "effective_batch": 256,
          "archived_effective": 256
        },
        {
          "phase": "finetune",
          "name": "opt4",
          "title": "opt4 fine-tune, seed 13 (archived effective batch 128)",
          "script": "experiment.py",
          "archived_args": "reports/runs/best/r9_opt4_base_seed13/args.json",
          "overrides": {
            "batch_size": 16,
            "grad_accum": 8,
            "workers": 0,
            "resume": true,
            "tag": "opt4_narrow_seed13"
          },
          "out": "opt4",
          "init_from_step": "mlm512",
          "micro_batch": 16,
          "grad_accum": 8,
          "workers": 0,
          "effective_batch": 128,
          "archived_effective": 128
        }
      ]
    },
    "opt4_wide_seed29": {
      "description": "Optional. 2048-byte encoder via continued MLM pre-training (round 7 recipe), then opt4, seed 29, matching reports/runs/best/r9_opt4_wide_seed29. Long: two weeks+ on one Mac.",
      "recommended": false,
      "task": "opt4",
      "model_name": "binprov",
      "backend": "mps",
      "steps": [
        {
          "phase": "pretrain512",
          "name": "mlm512",
          "title": "512-byte MLM pre-training (archived effective batch 256; warm start for 2048)",
          "script": "pretrain_mlm.py",
          "archived_args": "reports/runs/best/mlm512/pretrain_args.json",
          "overrides": {
            "batch_size": 16,
            "grad_accum": 16,
            "workers": 0,
            "save_every_epoch": true,
            "resume": true
          },
          "out": "mlm512",
          "init_from_step": null,
          "micro_batch": 16,
          "grad_accum": 16,
          "workers": 0,
          "effective_batch": 256,
          "archived_effective": 256
        },
        {
          "phase": "pretrain2048",
          "name": "mlm2048",
          "title": "2048-byte continued MLM from mlm512 (round 7 recipe, archived effective batch 64)",
          "script": "pretrain_mlm.py",
          "args": {
            "splits": "default",
            "split_name": "train",
            "seq_bytes": 2048,
            "pos_extend": "tile",
            "layers": 12,
            "hidden": 768,
            "heads": 12,
            "intermediate": 3072,
            "epochs": 10,
            "max_steps": null,
            "grad_accum": 32,
            "batch_size": 2,
            "lr": 0.0001,
            "weight_decay": 0.01,
            "warmup_ratio": 0.06,
            "clip_grad": 1.0,
            "mask_prob": 0.2,
            "mask_replace": 0.5,
            "random_replace": 0.5,
            "max_seqs_per_binary": null,
            "pair_prob": 0.0,
            "val_fraction": 0.02,
            "workers": 0,
            "seed": 1234,
            "fp32": false,
            "log_every": 50,
            "save_every_epoch": true,
            "resume": true
          },
          "out": "mlm2048",
          "init_from_step": "mlm512",
          "micro_batch": 2,
          "grad_accum": 32,
          "workers": 0,
          "effective_batch": 64,
          "archived_effective": 64
        },
        {
          "phase": "finetune",
          "name": "opt4",
          "title": "opt4 fine-tune at 2048 bytes, seed 29 (archived effective batch 32)",
          "script": "experiment.py",
          "archived_args": "reports/runs/best/r9_opt4_wide_seed29/args.json",
          "overrides": {
            "batch_size": 2,
            "grad_accum": 16,
            "workers": 0,
            "resume": true,
            "tag": "opt4_wide_seed29"
          },
          "out": "opt4",
          "init_from_step": "mlm2048",
          "micro_batch": 2,
          "grad_accum": 16,
          "workers": 0,
          "effective_batch": 32,
          "archived_effective": 32
        }
      ]
    }
  }
}
