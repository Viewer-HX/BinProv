            "mask_prob": 0.2,
            "mask_replace": 0.5,
            "random_replace": 0.5,
            "max_seqs_per_binary": null,
            "pair_prob": 0.0,
            "val_fraction": 0.02,
            "workers": 6,
            "seed": 1234,
            "fp32": false,
            "log_every": 50,
            "save_every_epoch": true,
            "resume": true
          },
          "out": "mlm2048",
          "init_from_step": "mlm512",
          "micro_batch": 4,
          "grad_accum": 16,
          "workers": 6,
          "effective_batch": 64,
          "archived_effective": 64
